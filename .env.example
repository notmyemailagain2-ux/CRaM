#
# Copy this file to ".env" and fill in values. Never share or commit .env.

# Port the server listens on.
PORT=3000

# Set to 127.0.0.1 when running behind Cloudflare Tunnel so the app is
# only reachable through Cloudflare. Leave unset to allow office-LAN access.
# HOST=127.0.0.1

# Long random string used to sign logins (64+ characters recommended).
# If left unset, one is generated automatically and saved to .jwt-secret.
# JWT_SECRET=

# How long a sign-in lasts before the user must sign in again.
JWT_EXPIRES_IN=8h

# Encrypts two-factor secrets. Auto-generated in .data-key if unset. BACK IT UP.
# DATA_KEY=



# Location of the SQLite database file.
# DB_PATH=crm.db

# Which proxies to trust for the visitor's real IP address.
# "loopback" is correct for Cloudflare Tunnel (cloudflared on the same machine).
TRUST_PROXY=loopback

